{
  "name": "yoob-ai-sdk-provider",
  "version": "0.1.0",
  "description": "Yoob speech-to-text and expressive text-to-speech for the Vercel AI SDK",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest --run"
  },
  "keywords": ["ai", "ai-sdk", "vercel", "yoob", "speech-to-text", "text-to-speech", "transcription", "tts", "stt"],
  "homepage": "https://yoob.com",
  "repository": { "type": "git", "url": "git+https://github.com/Yoob-com/ai-sdk-provider.git" },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.39",
    "@ai-sdk/provider-utils": "^5.0.83"
  },
  "peerDependencies": { "zod": "^3.25.76 || ^4.1.8" },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "ai": "^7.0.173",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0",
    "zod": "^4.6.7"
  },
  "engines": { "node": ">=20" }
}
